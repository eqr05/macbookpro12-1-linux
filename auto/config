#!/bin/sh
# live-build para MacBook Pro 2015 (MacBookPro11,4 / MacBookPro12,1)
# Mac = EFI puro: grub-efi, sin syslinux.
lb config noauto \
	--architectures amd64 \
	--distribution trixie \
	--archive-areas "main contrib non-free non-free-firmware" \
	--updates true \
	--security true \
	--binary-images iso-hybrid \
	--bootloaders "grub-efi" \
	--bootappend-live "boot=live components quiet username=macbook hostname=macbook locales=es_ES.UTF-8 keyboard-layouts=es keyboard-model=macintosh timezone=Europe/Madrid" \
	--debian-installer live \
	--debian-installer-gui true \
	--firmware-binary true \
	--iso-application "MacBook Linux - Debian 13 XFCE" \
	--iso-publisher "MacBook Linux" \
	--iso-volume "MACBOOK_LINUX" \
	--memtest none

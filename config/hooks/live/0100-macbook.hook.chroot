#!/bin/sh
set -e

# Teclado de consola para teclado Apple (ISO español)
cat > /etc/default/keyboard <<'EOF'
XKBMODEL="macintosh"
XKBLAYOUT="es"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

# Locale español
touch /etc/locale.gen
grep -q '^es_ES.UTF-8 UTF-8' /etc/locale.gen || echo 'es_ES.UTF-8 UTF-8' >> /etc/locale.gen
locale-gen
update-locale LANG=es_ES.UTF-8 LANGUAGE=es

# Zona horaria
echo Europe/Madrid > /etc/timezone
ln -sf /usr/share/zoneinfo/Europe/Madrid /etc/localtime

# Evitar chasquidos del codec CS4208 y clics de audio al suspender
echo 'options snd_hda_intel power_save=0 power_save_controller=N' > /etc/modprobe.d/macbook-audio.conf

# Cargar Wi-Fi Broadcom BCM43602 en el initramfs (útil tras suspender)
echo brcmfmac > /etc/initramfs-tools/modules
update-initramfs -u >/dev/null 2>&1 || true

# Servicios del entorno live
systemctl enable lightdm.service >/dev/null 2>&1 || true
systemctl enable NetworkManager.service >/dev/null 2>&1 || true
systemctl enable bluetooth.service >/dev/null 2>&1 || true

# Automontaje de particiones internas (tambien queda activo tras instalar)
chmod 0755 /usr/local/sbin/montar-discos
chmod 0644 /etc/systemd/system/montar-discos.service /etc/udev/rules.d/99-montar-discos.rules
systemctl enable montar-discos.service >/dev/null 2>&1 || true

# Guia en espanol: en el escritorio del live y en /etc/skel para que el
# usuario creado por Calamares tambien la reciba
chmod 0755 /usr/local/bin/colocar-ayuda.sh
chmod 0644 /etc/xdg/autostart/91-ayuda-macbook.desktop
chmod 0644 /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar-volman.xml
mkdir -p /etc/skel/Escritorio
cp /usr/share/macbook-linux/Comandos-Linux.txt /etc/skel/Escritorio/Comandos-Linux.txt
chmod 0644 /etc/skel/Escritorio/Comandos-Linux.txt

# Extras que Calamares instala solo en el sistema instalado
chmod 0644 /etc/calamares/modules/packages.conf

# sudo sin contraseña para el usuario live (por si cambia el nombre de usuario)
printf '%s\n' \
	'macbook ALL=(ALL) NOPASSWD:ALL' \
	'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/010-live-sudo
chmod 0440 /etc/sudoers.d/010-live-sudo
